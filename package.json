{
  "name": "dsh-gothic-theme",
  "version": "1.0.0",
  "description": "Gothic palette and emblem for the DeepSeek Harness Web UI: black, grey and burgundy surfaces with a cathedral-window brand mark",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugolnikov/dsh-gothic-theme.git"
  },
  "homepage": "https://github.com/ugolnikov/dsh-gothic-theme#readme",
  "keywords": ["dsh-plugin", "deepseek-harness", "theme", "gothic", "ui"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-theme"]
    }
  }
}
